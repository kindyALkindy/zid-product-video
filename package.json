{
  "name": "zid-product-video",
  "version": "1.0.0",
  "description": "A lightweight, dependency-free YouTube Web Component for Zid themes and e-commerce product pages.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "zid",
    "zid-theme",
    "web-component",
    "custom-element",
    "youtube",
    "youtube-video",
    "ecommerce",
    "vanilla-js",
    "typescript"
  ],
  "author": "kindyALkindy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindyALkindy/zid-product-video.git"
  },
  "bugs": {
    "url": "https://github.com/kindyALkindy/zid-product-video/issues"
  },
  "homepage": "https://github.com/kindyALkindy/zid-product-video",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
